{
  "name": "@racum/kepid",
  "version": "0.1.0",
  "description": "Satellite orbits packed into UUIDv7",
  "keywords": [
    "geo",
    "uuid",
    "satellite",
    "orbit",
    "tle",
    "ephemeris"
  ],
  "author": "Ronaldo Ferreira <ronaldo@racum.com>",
  "homepage": "https://github.com/racum/kepid",
  "repository": {
    "type": "git",
    "url": "https://github.com/racum/kepid",
    "directory": "javascript"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./min": "./dist/kepid.min.js"
  },
  "files": [
    "src",
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "npx --yes esbuild@0.28.2 src/index.js --bundle --minify --tree-shaking=true --format=esm --target=es2022 --legal-comments=none --outfile=dist/kepid.min.js && cp dist/kepid.min.js ../online/kepid.min.js",
    "test": "node --test"
  }
}
